{
  "_comment": "Single source of truth for text normalisation and ranking thresholds. Read by the Swift engine AND tools/reference_ranker.py, so the two can never drift. Change a number here, re-run `make eval`, commit the new results table.",
  "version": 1,
  "stopwords": [
    "a", "an", "and", "are", "as", "at", "be", "been", "but", "by", "can", "cant", "could",
    "do", "does", "doesnt", "dont", "for", "from", "get", "got", "has", "have", "help", "how",
    "i", "im", "in", "into", "is", "isnt", "it", "its", "just", "keep", "keeps", "me", "my",
    "need", "not", "of", "on", "or", "our", "please", "should", "so", "some", "that", "the",
    "their", "then", "there", "this", "to", "up", "us", "was", "wont", "we", "what", "when",
    "where", "which", "why", "will", "with", "would", "you", "your"
  ],
  "phrases": {
    "wi fi": "wifi",
    "log in": "login",
    "sign in": "login",
    "signin": "login",
    "logon": "login",
    "two factor": "2fa",
    "two step": "2fa",
    "money back": "refund",
    "credit card": "card",
    "debit card": "card",
    "dark mode": "darkmode",
    "face id": "faceid"
  },
  "synonyms": {
    "pwd": "password",
    "passcode": "password",
    "passphrase": "password",
    "internet": "wifi",
    "wireless": "wifi",
    "mfa": "2fa",
    "otp": "2fa",
    "reimburse": "refund",
    "reimbursement": "refund",
    "invoice": "receipt",
    "invoices": "receipt",
    "subscription": "plan",
    "subscriptions": "plan",
    "membership": "plan",
    "phone": "device",
    "iphone": "device",
    "tablet": "device",
    "laptop": "device",
    "erase": "delete",
    "remove": "delete",
    "photo": "photos",
    "pictures": "photos",
    "picture": "photos",
    "pics": "photos",
    "slow": "performance",
    "laggy": "performance",
    "lag": "performance",
    "crash": "crashes",
    "crashing": "crashes",
    "freezes": "crashes",
    "freezing": "crashes"
  },
  "stemRules": [
    { "suffix": "ies",  "replace": "y",  "minLength": 5, "unlessSuffix": "" },
    { "suffix": "sses", "replace": "ss", "minLength": 5, "unlessSuffix": "" },
    { "suffix": "ing",  "replace": "",   "minLength": 6, "unlessSuffix": "" },
    { "suffix": "ed",   "replace": "",   "minLength": 6, "unlessSuffix": "" },
    { "suffix": "s",    "replace": "",   "minLength": 4, "unlessSuffix": "ss" },
    { "suffix": "e",    "replace": "",   "minLength": 5, "unlessSuffix": "" }
  ],
  "ranking": {
    "k1": 1.2,
    "b": 0.75,
    "titleWeight": 2,
    "tagWeight": 2,
    "maxQueryCharacters": 500,
    "defaultLimit": 5,
    "highCoverage": 0.75,
    "highMinScore": 4.0,
    "highMinMargin": 1.15,
    "mediumCoverage": 0.5,
    "mediumRelative": 0.5,
    "feedbackWeight": 0.15,
    "feedbackCap": 3
  }
}
